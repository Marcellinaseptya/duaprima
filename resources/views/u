public function create()
    {
        $sopirs = Sopir::all();
        $truks = Truk::all();
        return view('perbaikan.create', compact('sopirs', 'truks'));
    }

    public function store(Request $request)
    {
        $validated = $request->validate([
            'sopir_id' => 'required|exists:sopirs,id',
            'truk_id' => 'required|exists:truks,id',
            'keluhan' => 'required|string',
            'status' => 'required|string',
            'foto' => 'nullable|image|max:2048',
            'tanggal_perbaikan' => 'required|date',
        ]);

        if ($request->hasFile('foto')) {
            $path = $request->file('foto')->store('perbaikan_foto', 'public');
            $validated['foto'] = $path;
        }

        Perbaikan::create($validated);

        return redirect()->route('perbaikan')->with('success', 'Data perbaikan berhasil ditambahkan');
    }